{
  "name": "twin-web-concept",
  "version": "1.0.0",
  "description": "Desktop-концепт Twin by TALENT по комплекту v1.3",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "build:preview": "TWIN_BASE_PATH=/twin-web-concept npm run build",
    "publish:preview": "node scripts/publish-preview.mjs",
    "verify:online": "node scripts/verify-online.mjs",
    "twin:tokens": "node scripts/twin-system.mjs tokens",
    "twin:check": "node scripts/twin-system.mjs check",
    "twin:task": "node scripts/twin-system.mjs task",
    "twin:guard": "node scripts/twin-system.mjs guard",
    "twin:test": "node --test scripts/twin-system.test.mjs tests/journey-accordion.test.mjs",
    "build:v2": "node scripts/build-v2.mjs",
    "publish:v2": "node scripts/publish-v2.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AURRRUS/twin-web-concept.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/AURRRUS/twin-web-concept/issues"
  },
  "homepage": "https://github.com/AURRRUS/twin-web-concept#readme",
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
