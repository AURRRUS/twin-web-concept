---
import {ReferenceJourney,ReferenceRest} from '../../components/v2/ReferencePage';
import '../../styles/v2/reference-page.css';
import '../../styles/v2/hero-journey.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const media=(file:string)=>`${base}media/${file}`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="Twin by TALENT — цифровая инфраструктура продаж девелоперского проекта. Исследование проекта, выбор лота и четыре канала продаж на общей цифровой основе."/><title>Twin by TALENT — цифровая инфраструктура продаж</title><link rel="icon" type="image/webp" href={media('approved-20261027/mark-light.webp')}/></head><body class="vis004"><a class="r4-skip" href="#main">Перейти к содержанию</a><main id="main"><div class="r4-opening"><img class="r4-opening-photo" src={media('top-v2/hero.webp')} alt="" fetchpriority="high" width="2574" height="1459"/><img class="r4-opening-foreground" src={media('top-v2/hero.webp')} alt="" width="2574" height="1459"/><section class="r4-hero" id="top"><header class="r4-header r4-wrap"><a class="r4-logo" href="#top" aria-label="Twin by TALENT — главная"><img src={media('approved-20261027/logo-light.webp')} alt="Twin by TALENT" width="1774" height="887"/></a><nav aria-label="Основная навигация"><a href="#journey">Продукт</a><a href="#channels">Сценарии</a><a href="#launch">Запуск</a></nav><a class="r4-button" href="#contact">Обсудить проект <span aria-hidden="true">→</span></a><details class="r4-menu"><summary>Меню</summary><nav aria-label="Мобильная навигация"><a href="#journey">Продукт</a><a href="#channels">Сценарии</a><a href="#launch">Запуск</a><a href="#contact">Обсудить проект</a></nav></details></header><div class="r4-hero-copy r4-wrap"><span class="eyebrow">Демонстрационный проект</span><h1><span>Цифровая</span><span class="bronze">инфраструктура продаж</span><span>девелоперского проекта</span></h1><p>Раскрывайте преимущества проекта<br/> и помогайте покупателю выбирать:<br/> на сайте, дистанционно, через агентов<br/> и в офисе продаж</p><a class="r4-button" href={`${base}demo/`}>Посмотреть Twin <span aria-hidden="true">→</span></a></div></section><ReferenceJourney client:load/></div><ReferenceRest client:load/></main><footer class="r4-footer"><div class="r4-wrap"><a class="r4-logo" href="#top"><img src={media('approved-20261027/logo-dark.webp')} alt="Twin by TALENT" width="1441" height="621"/></a><nav aria-label="Навигация в подвале"><a href="#journey">Продукт</a><a href="#channels">Сценарии</a><a href="#composition">Состав</a><a href="#launch">Запуск</a></nav><small>Демонстрационный проект</small></div></footer><script>const opening=document.querySelector<HTMLElement>('.r4-opening'),copy=document.querySelector<HTMLElement>('.r4-hero-copy');if(opening&&copy){const measure=()=>opening.style.setProperty('--hero-copy-height',`${copy.offsetTop+copy.offsetHeight}px`);new ResizeObserver(measure).observe(copy);document.fonts.ready.then(measure);measure();}document.querySelectorAll('.r4-menu a').forEach(a=>a.addEventListener('click',()=>document.querySelector('.r4-menu')?.removeAttribute('open')));</script></body></html>
