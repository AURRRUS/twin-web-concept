---
import { Journey } from '../../components/v2/Journey';
import content from '../../../.twin/tasks/VIS-002/content.json';
import tokens from '../../../.twin/v2/tokens.json';
import '../../styles/v2/site.css';
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const media=(p:string)=>`${base}media/${p}`;
const images={project:media('final-r2/journey/project.png'),corpus:media('final-r2/journey/corpus.png'),floor:media('final-r2/journey/floor.png'),lot:media('final-r2/journey/lot.png')};
const vars=(i:number)=>Object.entries(tokens.roles).map(([k,v])=>`--ts-v2-${k}-size:${v.size[i]}px;--ts-v2-${k}-line:${v.lineHeight[i]}px`).join(';')+`;--ts-v2-gutter:${tokens.layout.gutter[i]}px`;
const css=`.twin-v2{${vars(0)};${Object.entries(tokens.colors).map(([k,v])=>`--ts-v2-${k}:${v}`).join(';')}}@media(min-width:768px){.twin-v2{${vars(1)}}}@media(min-width:1100px){.twin-v2{${vars(2)}}}@media(min-width:1800px){.twin-v2{${vars(3)}}}`;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Twin by TALENT — цифровая инфраструктура продаж</title><style is:inline set:html={css}/></head><body class="twin-v2"><main><section class="tv2-hero"><img class="tv2-hero-image" src={media('top-v2/hero.webp')} alt="" fetchpriority="high"/><header class="tv2-header tv2-wrap"><a class="tv2-logo" href={`${base}`} aria-label="Twin by TALENT — главная"><img src={media('logo.webp')} alt="Twin by TALENT"/></a><nav aria-label="Основная навигация"><a href="#journey">Продукт</a><a href={`${base}#channels`}>Сценарии</a><a href={`${base}#launch`}>Запуск</a></nav><a class="tv2-contact" href={`${base}#contact`}>{content.hero.secondaryCta} <span aria-hidden="true">→</span></a></header><div class="tv2-wrap tv2-hero-copy"><h1>Цифровая <span>инфраструктура продаж</span><br/>девелоперского проекта</h1><p>{content.hero.intro[0]}<br/>{content.hero.intro[1]}<br/>{content.hero.channels}</p><a class="tv2-button" href={`${base}demo/`}>{content.hero.cta}<span aria-hidden="true">→</span></a></div><small class="tv2-hero-note">{content.hero.imageNote}</small><div class="tv2-transition" aria-hidden="true"><svg viewBox="0 0 1440 96" preserveAspectRatio="none"><path d="M0 0 L1440 96 L0 96 Z" fill="#FAFAF8"/><path d="M0 0 L1440 96" fill="none" stroke="#B58B60" stroke-width="1"/></svg></div></section><Journey client:load journey={content.journey} fallback={content.fallback} imageUrls={images} demoHref={`${base}demo/`}/></main></body></html>
