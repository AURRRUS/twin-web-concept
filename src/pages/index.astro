---
import App from '../components/App';
import { sitePath } from '../lib/paths';
import '../styles/site.css';
import '../styles/top-screens.css';
import '../styles/design.css';
import '../styles/salesStory.css';
import '../styles/journeyComparison.css';
import '../styles/journeyV456.css';
import '../styles/journeyV4.css';
import '../styles/journeyV5.css';
import '../styles/journeyV6.css';
import dewiRegular from '../assets/fonts/RFDewiExpanded-Regular.ttf?url';
import dewiBlack from '../assets/fonts/RFDewiExpanded-Black.ttf?url';
import interTight from '../assets/fonts/inter-tight-variable.woff2?url';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <link rel="preload" href={dewiRegular} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={dewiBlack} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={interTight} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Twin — цифровая инфраструктура продаж девелоперского проекта. Коммерческий цифровой двойник и единая основа для всех каналов продаж." />
    <title>Twin by TALENT — цифровая инфраструктура продаж</title>
    <link rel="icon" type="image/svg+xml" href={sitePath('/favicon.svg')} />
  </head>
  <body><App page="home" client:load /></body>
</html>
